<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             xmlns:views="using:Paarde.Avalonia.Views"
             x:Class="Paarde.Avalonia.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding WorkingDirectoryPath}"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Command="{Binding RefreshTreeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Refresh" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <!-- Epic 25, T12 (R10): lets the user pick a working directory from Explorer itself,
                 rather than only ever inheriting whichever one Compose/Prompt last saved. -->
            <Button Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="OpenFolder" FontSize="14" />
                    <TextBlock Text="Open folder..." />
                </StackPanel>
            </Button>
            <!-- Epic 25, T12 (R2): collapses/expands the docked Assistant panel by driving the
                 same "width 0 is collapsed" convention ResizablePaneHelper already uses for the
                 tree pane - see ExplorerView.axaml.cs's OnToggleAssistantPanelButtonClick. -->
            <Button Name="ToggleAssistantPanelButton" Click="OnToggleAssistantPanelButtonClick" ToolTip.Tip="Show or hide the Assistant panel.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Comment" FontSize="14" />
                    <TextBlock Text="Assistant" />
                </StackPanel>
            </Button>
            <!-- specs/editor-focus-layout R1: hides the tree + Assistant panel for a
                 distraction-free view of the editor(s) alone. Ctrl+K Z does the same thing - see
                 ExplorerView.axaml.cs's OnViewKeyDown. -->
            <Button Command="{Binding ToggleZenModeCommand}" ToolTip.Tip="Toggle zen mode (Ctrl+K, Z).">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="FullScreen" FontSize="14" />
                    <TextBlock Text="Zen mode" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ui:InfoBar Grid.Row="1"
                    Margin="8,0,8,8"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity}"
                    IsClosable="False"
                    IsOpen="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        <!-- T8.1.3: split view - tree on the left, a read-only preview of whatever file is
             selected on the right. The preview reuses CodeEditor (same control Tutorial uses for
             editing proposed changes) but never binds to ProposedFileChangeViewModel.EditedContent
             - Explorer stays a browse/view surface, editing a proposal stays the Tutorial page's job. -->
        <!-- T8.2.3: resizable/persisted pane widths - see ResizablePaneHelper, wired up in
             ExplorerView.axaml.cs. Dragging TreeSplitter all the way shut collapses the tree. -->
        <!-- Epic 25, T12 (R2): the docked Assistant panel - a third column/splitter alongside the
             existing tree/content split, same ResizablePaneHelper + "drag shut to collapse"
             convention as TreeSplitter, persisted separately via ExplorerAssistantPanelWidth. -->
        <Grid Grid.Row="2" Margin="8" Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0"
                      ItemsSource="{Binding Root.Children}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:FileTreeNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="●"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       ToolTip.Tip="Touched by the current proposal"
                                       IsVisible="{Binding IsTouched}" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Name="TreeSplitter" Width="4" ResizeDirection="Columns" />

            <!-- Epic 23, T23.1.1/T23.1.2: multi-file tabbed editing - every file opened from the
                 tree this visit stays open as its own tab (ExplorerFileTabControl instance), same
                 OpenTabs/SelectedTab + TabControl.ContentTemplate shape TutorialView.axaml already
                 established for its own tab strip, rather than the previous single ContentControl
                 that threw its editor away on every tree selection. -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Margin="8"
                           Text="Select a file on the left to preview it here."
                           Opacity="0.7"
                           IsVisible="{Binding !HasOpenTabs}" />

                <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding HasOpenTabs}">
                    <Button Grid.Row="0"
                             Content="Close Tab"
                             HorizontalAlignment="Right"
                             Margin="8,0,0,4"
                             Command="{Binding CloseSelectedTabCommand}"
                             ToolTip.Tip="Close the active tab." />

                    <!-- specs/editor-focus-layout R2/R3/R4: FluentAvalonia's ui:TabView (native
                         CanDragTabs/CanReorderTabs, vs. the plain TabControl this used to be) -
                         two instances, one per group, each bound to its own real
                         ObservableCollection (PrimaryGroupTabs/SecondaryGroupTabs) rather than a
                         LINQ projection, so drag-reorder can mutate the list directly. The
                         secondary TabView/splitter column collapses to width 0 automatically
                         (ExplorerView.axaml.cs's OnViewModelPropertyChanged) once its last tab
                         closes. -->
                    <Grid Grid.Row="1" Margin="8,0,0,0" Name="SplitGroupGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <ui:TabView Grid.Column="0"
                                    TabItems="{Binding PrimaryGroupTabs}"
                                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                    CanDragTabs="True"
                                    CanReorderTabs="True"
                                    IsAddTabButtonVisible="False"
                                    TabCloseRequested="OnTabViewTabCloseRequested">
                            <ui:TabView.TabItemTemplate>
                                <!-- Bug fix (freeze on new tab): when TabView attaches a brand-new tab's
                                     container to the visual tree, everything in this template briefly
                                     inherits the TabView's own ExplorerViewModel DataContext before the
                                     real per-tab OpenFileTabViewModel is assigned. Any compiled (strongly-
                                     typed) binding that evaluates during that window throws
                                     InvalidCastException unhandled on the dispatcher thread, which wedges
                                     the whole UI. x:CompileBindings="False" makes every binding in this
                                     template use reflection instead, which tolerates the mismatch. Applies
                                     to the whole template (not just one binding) because any binding here
                                     can be the one whose subscribe happens to fire during the race. -->
                                <DataTemplate x:DataType="vm:OpenFileTabViewModel" x:CompileBindings="False">
                                    <ui:TabViewItem x:Name="TabContainer" IsClosable="True">
                                        <ui:TabViewItem.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ui:SymbolIcon Symbol="Pin" FontSize="12" IsVisible="{Binding IsPinned}" />
                                                <TextBlock Text="{Binding FileName}"
                                                           MaxWidth="200"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding FilePath}" />
                                                <TextBlock Text="*"
                                                           FontWeight="Bold"
                                                           IsVisible="{Binding IsDirty}"
                                                           ToolTip.Tip="This file has unsaved edits." />
                                            </StackPanel>
                                        </ui:TabViewItem.Header>
                                        <ui:TabViewItem.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding PinMenuItemLabel}" Command="{Binding TogglePinCommand}" />
                                                <MenuItem Header="Split right" Command="{Binding RequestSplitRightCommand}" IsVisible="{Binding CanSplitRight}" />
                                            </ContextMenu>
                                        </ui:TabViewItem.ContextMenu>
                                        <!-- Bug fix (blank editor on open): FluentAvalonia's TabView
                                             reparents this control out of the TabViewItem into its own
                                             TabContentPresenter once this tab is selected (confirmed via
                                             decompiled TabView.UpdateTabContent()), which severs ordinary
                                             DataContext *inheritance* since it's a visual-tree reparent.
                                             A self-referencing DataContext="{Binding}" does NOT fix this: it
                                             evaluates once, before TabViewItem.DataContext is even assigned
                                             (Build() sets children first, root's DataContext last), and that
                                             snapshot never updates afterwards (confirmed via live memory dump:
                                             its EffectiveValue had no active binding entry, just a dead,
                                             stale value - ExplorerView's own ExplorerViewModel, not this
                                             tab's OpenFileTabViewModel). Binding by ElementName instead
                                             resolves via the template's NameScope, not visual-tree position,
                                             so it stays correct both before Build() finishes and after the
                                             reparent. -->
                                        <views:ExplorerFileTabControl DataContext="{Binding DataContext, ElementName=TabContainer}" />
                                    </ui:TabViewItem>
                                </DataTemplate>
                            </ui:TabView.TabItemTemplate>
                        </ui:TabView>

                        <GridSplitter Grid.Column="1"
                                      Name="SplitGroupSplitter"
                                      Width="4"
                                      ResizeDirection="Columns"
                                      IsVisible="{Binding HasSecondaryGroupTabs}" />

                        <ui:TabView Grid.Column="2"
                                    IsVisible="{Binding HasSecondaryGroupTabs}"
                                    TabItems="{Binding SecondaryGroupTabs}"
                                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                    CanDragTabs="True"
                                    CanReorderTabs="True"
                                    IsAddTabButtonVisible="False"
                                    TabCloseRequested="OnTabViewTabCloseRequested">
                            <ui:TabView.TabItemTemplate>
                                <!-- Bug fix (freeze on new tab): see matching comment on the primary
                                     TabView's header template above - same compiled-binding DataContext
                                     race, same fix, applied to the whole template. -->
                                <DataTemplate x:DataType="vm:OpenFileTabViewModel" x:CompileBindings="False">
                                    <ui:TabViewItem x:Name="TabContainer" IsClosable="True">
                                        <ui:TabViewItem.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ui:SymbolIcon Symbol="Pin" FontSize="12" IsVisible="{Binding IsPinned}" />
                                                <TextBlock Text="{Binding FileName}"
                                                           MaxWidth="200"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding FilePath}" />
                                                <TextBlock Text="*"
                                                           FontWeight="Bold"
                                                           IsVisible="{Binding IsDirty}"
                                                           ToolTip.Tip="This file has unsaved edits." />
                                            </StackPanel>
                                        </ui:TabViewItem.Header>
                                        <ui:TabViewItem.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding PinMenuItemLabel}" Command="{Binding TogglePinCommand}" />
                                            </ContextMenu>
                                        </ui:TabViewItem.ContextMenu>
                                        <!-- Bug fix (blank editor on open): see matching comment on the
                                             primary TabView's item template above - same fix. -->
                                        <views:ExplorerFileTabControl DataContext="{Binding DataContext, ElementName=TabContainer}" />
                                    </ui:TabViewItem>
                                </DataTemplate>
                            </ui:TabView.TabItemTemplate>
                        </ui:TabView>
                    </Grid>
                </Grid>
            </Grid>

            <!-- specs/editor-focus-layout R5: Ctrl+Tab MRU switcher - same Popup+ListBox shape
                 ShellView.axaml's Quick Open already uses. Opened/advanced on KeyDown, committed
                 on Ctrl's KeyUp - see ExplorerView.axaml.cs's OnViewKeyDown/OnViewKeyUp. -->
            <Popup IsOpen="{Binding IsMruSwitcherOpen}"
                   PlacementTarget="WorkspaceGrid"
                   Placement="Center">
                <Border Classes="popup-chrome"
                        MinWidth="260">
                    <ListBox ItemsSource="{Binding MruSwitcherItems}" SelectedItem="{Binding MruSwitcherHighlighted}">
                        <ListBox.ItemTemplate>
                            <!-- Bug fix (freeze on new tab): same compiled-binding DataContext race as
                                 the TabView header templates above. -->
                            <DataTemplate x:DataType="vm:OpenFileTabViewModel" x:CompileBindings="False">
                                <TextBlock Text="{Binding FileName}" Margin="8,4" ToolTip.Tip="{Binding FilePath}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <GridSplitter Grid.Column="3" Name="AssistantPanelSplitter" Width="4" ResizeDirection="Columns" />

            <!-- Bug fix (post-T12 runtime crash): DataContext="{Binding AssistantPanel}" as a plain
                 attribute raced against AssistantPanelControl's own compiled bindings seeing the
                 still-inherited ExplorerViewModel before the binding resolved. Content/
                 ContentTemplate assigns DataContext atomically instead - see AssistantPanelControl.axaml's
                 own fix for the same issue. -->
            <ContentControl Grid.Column="4" Content="{Binding AssistantPanel}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:AssistantPanelViewModel">
                        <views:AssistantPanelControl />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
