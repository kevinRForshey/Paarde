<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             xmlns:views="using:Paarde.Avalonia.Views"
             x:Class="Paarde.Avalonia.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding WorkingDirectoryPath}"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshTreeCommand}" />
            <!-- Epic 25, T12 (R10): lets the user pick a working directory from Explorer itself,
                 rather than only ever inheriting whichever one Compose/Prompt last saved. -->
            <Button Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="OpenFolder" FontSize="14" />
                    <TextBlock Text="Open folder..." />
                </StackPanel>
            </Button>
            <!-- Epic 25, T12 (R2): collapses/expands the docked Assistant panel by driving the
                 same "width 0 is collapsed" convention ResizablePaneHelper already uses for the
                 tree pane - see ExplorerView.axaml.cs's OnToggleAssistantPanelButtonClick. -->
            <Button Name="ToggleAssistantPanelButton" Click="OnToggleAssistantPanelButtonClick" ToolTip.Tip="Show or hide the Assistant panel.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Comment" FontSize="14" />
                    <TextBlock Text="Assistant" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="8,0,8,8"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        <!-- T8.1.3: split view - tree on the left, a read-only preview of whatever file is
             selected on the right. The preview reuses CodeEditor (same control Tutorial uses for
             editing proposed changes) but never binds to ProposedFileChangeViewModel.EditedContent
             - Explorer stays a browse/view surface, editing a proposal stays the Tutorial page's job. -->
        <!-- T8.2.3: resizable/persisted pane widths - see ResizablePaneHelper, wired up in
             ExplorerView.axaml.cs. Dragging TreeSplitter all the way shut collapses the tree. -->
        <!-- Epic 25, T12 (R2): the docked Assistant panel - a third column/splitter alongside the
             existing tree/content split, same ResizablePaneHelper + "drag shut to collapse"
             convention as TreeSplitter, persisted separately via ExplorerAssistantPanelWidth. -->
        <Grid Grid.Row="2" Margin="8" Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0"
                      ItemsSource="{Binding Root.Children}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:FileTreeNodeViewModel" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="●"
                                       Foreground="{DynamicResource SystemAccentColor}"
                                       ToolTip.Tip="Touched by the current proposal"
                                       IsVisible="{Binding IsTouched}" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Name="TreeSplitter" Width="4" ResizeDirection="Columns" />

            <!-- Epic 23, T23.1.1/T23.1.2: multi-file tabbed editing - every file opened from the
                 tree this visit stays open as its own tab (ExplorerFileTabControl instance), same
                 OpenTabs/SelectedTab + TabControl.ContentTemplate shape TutorialView.axaml already
                 established for its own tab strip, rather than the previous single ContentControl
                 that threw its editor away on every tree selection. -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Margin="8"
                           Text="Select a file on the left to preview it here."
                           Opacity="0.7"
                           IsVisible="{Binding !HasOpenTabs}" />

                <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding HasOpenTabs}">
                    <Button Grid.Row="0"
                             Content="Close Tab"
                             HorizontalAlignment="Right"
                             Margin="8,0,0,4"
                             Command="{Binding CloseSelectedTabCommand}"
                             ToolTip.Tip="Close the active tab." />
                    <TabControl Grid.Row="1"
                                Margin="8,0,0,0"
                                ItemsSource="{Binding OpenTabs}"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OpenFileTabViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding FileName}"
                                               MaxWidth="200"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding FilePath}" />
                                    <TextBlock Text="*"
                                               FontWeight="Bold"
                                               IsVisible="{Binding IsDirty}"
                                               ToolTip.Tip="This file has unsaved edits." />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:OpenFileTabViewModel">
                                <views:ExplorerFileTabControl />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Name="AssistantPanelSplitter" Width="4" ResizeDirection="Columns" />

            <!-- Bug fix (post-T12 runtime crash): DataContext="{Binding AssistantPanel}" as a plain
                 attribute raced against AssistantPanelControl's own compiled bindings seeing the
                 still-inherited ExplorerViewModel before the binding resolved. Content/
                 ContentTemplate assigns DataContext atomically instead - see AssistantPanelControl.axaml's
                 own fix for the same issue. -->
            <ContentControl Grid.Column="4" Content="{Binding AssistantPanel}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:AssistantPanelViewModel">
                        <views:AssistantPanelControl />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
