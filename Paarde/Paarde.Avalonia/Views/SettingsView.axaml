<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:Avalonia.Styling"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             xmlns:models="using:Paarde.Core.Models"
             x:Class="Paarde.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Personalization" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Theme" />

            <StackPanel Margin="0,4,0,0" Spacing="4">
                <RadioButton Content="Light"
                             GroupName="AppTheme"
                             Command="{Binding SwitchThemeCommand}"
                             CommandParameter="{x:Static styling:ThemeVariant.Light}"
                             IsChecked="{Binding ThemeVariant, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                <RadioButton Content="Dark"
                             GroupName="AppTheme"
                             Command="{Binding SwitchThemeCommand}"
                             CommandParameter="{x:Static styling:ThemeVariant.Dark}"
                             IsChecked="{Binding ThemeVariant, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
                <RadioButton Content="Default"
                             GroupName="AppTheme"
                             Command="{Binding SwitchThemeCommand}"
                             CommandParameter="{x:Static styling:ThemeVariant.Default}"
                             IsChecked="{Binding ThemeVariant, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Default, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="LLM runner" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <RadioButton Content="Claude Code CLI"
                         GroupName="LlmRunner"
                         IsChecked="{Binding SelectedRunnerKind, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ClaudeCli}" />
            <RadioButton Content="Anthropic API (direct)"
                         GroupName="LlmRunner"
                         IsChecked="{Binding SelectedRunnerKind, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AnthropicApi}" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="Claude Code CLI" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Executable path" FontSize="12" Opacity="0.7" />
            <TextBox Text="{Binding ClaudeCliExecutablePath}" Watermark="claude" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Arguments" FontSize="12" Opacity="0.7" />
            <TextBox Text="{Binding ClaudeCliArguments}" Watermark="-p" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <CheckBox Content="Enable read-only agent tools" IsChecked="{Binding AgentToolsEnabled, Mode=TwoWay}"
                      ToolTip.Tip="Lets the model read files, grep, and glob the project itself while generating a response, instead of only seeing the context Paarde inlined. Doesn't let it write or run commands. Requires a Claude Code CLI build that supports --allowedTools/--permission-mode (run `claude --version`; upgrade with `npm install -g @anthropic-ai/claude-code` if enabling this fails)." />
            <TextBlock Text="Applies to whichever runner above is selected." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="Anthropic API" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="API key" FontSize="12" Opacity="0.7" />
            <TextBox Text="{Binding AnthropicApiKey}" PasswordChar="•" Watermark="sk-ant-..." />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Model" FontSize="12" Opacity="0.7" />
            <ComboBox ItemsSource="{Binding AvailableModels}"
                      SelectedItem="{Binding SelectedAnthropicModel, Mode=TwoWay}"
                      HorizontalAlignment="Left"
                      MinWidth="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AnthropicModelInfo">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="Build &amp; test" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Build command" FontSize="12" Opacity="0.7" />
            <TextBlock Text="Run after applying changes to check the result still builds. Leave blank to skip."
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
            <TextBox Text="{Binding BuildCommand}" Watermark="dotnet build" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Test command" FontSize="12" Opacity="0.7" />
            <TextBlock Text="Run after a successful build. Leave blank to skip."
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
            <TextBox Text="{Binding TestCommand}" Watermark="dotnet test" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="Code intelligence" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Powers Explorer's diagnostics, go-to-definition, and find-references, one language server per row. Each must speak the Language Server Protocol over stdio. Clear a row's executable path to disable that language."
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding LanguageServerRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding LanguageId}" FontWeight="SemiBold" />
                                <TextBlock Text="Available"
                                           Foreground="Green"
                                           IsVisible="{Binding IsAvailable}" />
                                <TextBlock Text="Not found on PATH"
                                           Foreground="OrangeRed"
                                           IsVisible="{Binding !IsAvailable}" />
                            </StackPanel>
                            <TextBox Text="{Binding ExecutablePath}" Watermark="executable path" />
                            <TextBox Text="{Binding Arguments}" Watermark="arguments" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,16,0,0" Text="Run configurations" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Powers the Build/Run/Stop toolbar - detected automatically for the working directory picked on the Prompt page, or add one by hand for anything detection misses."
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,8,0,0"
                   Text="No working directory selected yet. Pick one on the Prompt page."
                   FontSize="12"
                   Opacity="0.7"
                   IsVisible="{Binding !HasRunConfigurationsWorkingDirectory}" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RunConfigurationRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Auto-detected" Foreground="Green" IsVisible="{Binding IsAutoDetected}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Hand-edited" Opacity="0.7" IsVisible="{Binding !IsAutoDetected}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteCommand}" />
                            </Grid>
                            <TextBox Text="{Binding Name}" Watermark="name" />
                            <TextBox Text="{Binding LanguageId}" Watermark="language id (csharp/python/typescript)" />
                            <TextBox Text="{Binding WorkingDirectoryPath}" Watermark="directory the commands below run in" />
                            <TextBox Text="{Binding ProjectRelativePath}" Watermark="project/script path (for your reference)" />
                            <TextBox Text="{Binding BuildCommand}" Watermark="build command (leave blank to skip)" />
                            <TextBox Text="{Binding RunCommand}" Watermark="run command" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Margin="0,8,0,0" Content="Add run configuration" Command="{Binding AddRunConfigurationCommand}" HorizontalAlignment="Left" />

        <TextBlock Margin="0,16,0,0" Text="Prompt template" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Override" FontSize="12" Opacity="0.7" />
            <TextBlock Text="Instructions sent to Claude Code before your prompt. Leave blank to use the built-in default shown below."
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
            <TextBox Text="{Binding PromptTemplateOverride}"
                     Watermark="Leave blank to use the built-in default"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     Height="160"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Button Content="Reset to default" Command="{Binding ResetPromptTemplateCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Built-in default" FontSize="12" Opacity="0.7" />
            <TextBox Text="{Binding DefaultPromptTemplate}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     Height="160"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="About this application" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Margin="0,4,0,0" Spacing="4">
            <TextBlock Text="{Binding VersionDescription}" />
        </StackPanel>
    </StackPanel>
</UserControl>
