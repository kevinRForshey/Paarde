<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:coreVm="using:Paarde.Core.ViewModels"
             xmlns:viewmodels="using:Paarde.Avalonia.ViewModels"
             xmlns:controls="using:Paarde.Avalonia.Controls"
             xmlns:helpers="using:Paarde.Avalonia.Helpers"
             x:Class="Paarde.Avalonia.Views.TutorialDetailControl"
             x:DataType="coreVm:ProposedFileChangeViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding FilePath}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       x:CompileBindings="False" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <Button Name="UndoButton" Content="Undo" Click="OnUndoButtonClick"
                     ToolTip.Tip="Undo the last edit (Ctrl+Z)." />
            <Button Name="RedoButton" Content="Redo" Click="OnRedoButtonClick"
                     ToolTip.Tip="Redo the last undone edit (Ctrl+Y)." />
            <Button Command="{Binding RevertToProposedCommand}"
                     Classes="danger"
                     ToolTip.Tip="Discard your edits and go back to what Claude proposed.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Restore" FontSize="14" />
                    <TextBlock Text="Revert to proposed" />
                </StackPanel>
            </Button>
            <Button Command="{Binding RevertToOriginalCommand}"
                     Classes="danger"
                     ToolTip.Tip="Discard your edits and the proposed change, going back to the file on disk.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Restore" FontSize="14" />
                    <TextBlock Text="Revert to original" />
                </StackPanel>
            </Button>
            <TextBlock Text="Edited" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.7" />
        </StackPanel>

        <!-- One editable buffer per file: every step's "Apply this change" writes this file's
             whole content (see FileChangeApplyService), so editing happens here rather than on
             each step's snippet. -->
        <controls:CodeEditor Name="Editor"
                              Grid.Row="2"
                              Margin="0,0,0,8"
                              helpers:TextEditorExtensions.BindableText="{Binding EditedContent, Mode=TwoWay}"
                              FilePath="{Binding FilePath}"
                              DiffLines="{Binding DiffLines}"
                              DiffHunks="{Binding DiffHunks}"
                              IsReadOnly="False"
                              Height="320"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="3" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding HasSelectableHunks}">
            <Button Content="Select all" Command="{Binding SelectAllHunksCommand}" />
            <Button Content="Select none" Command="{Binding SelectNoHunksCommand}" />
            <Button Content="Invert selection" Command="{Binding InvertHunkSelectionCommand}" />
            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <!-- T8.4.3: lets the user jump between steps instead of only scrolling, with a position
             indicator for tutorials with many steps. Hidden entirely for a file with no resolved
             steps (RebuildSteps leaves Steps empty), same as the select-all row above. -->
        <StackPanel Name="StepNavigationPanel" Grid.Row="4" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <Button Name="PreviousStepButton" Content="◀ Previous" Click="OnPreviousStepButtonClick"
                     ToolTip.Tip="Jump to the previous step." />
            <Button Name="NextStepButton" Content="Next ▶" Click="OnNextStepButtonClick"
                     ToolTip.Tip="Jump to the next step." />
            <TextBlock Name="StepNavigationLabel" VerticalAlignment="Center" />
            <ProgressBar Name="StepProgressBar" Width="120" Height="6" VerticalAlignment="Center" Minimum="0" />
        </StackPanel>

        <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="StepsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TutorialStepViewModel">
                        <StackPanel Margin="0,0,0,24" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox IsChecked="{Binding Hunk.IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                          ToolTip.Tip="Include this step's change when applying." />
                                <TextBlock Text="{Binding StepLabel}" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Text="Applied" IsVisible="{Binding Hunk.IsApplied}" VerticalAlignment="Center"
                                           FontStyle="Italic" Opacity="0.7" />
                            </StackPanel>
                            <controls:MarkdownTextBlock Text="{Binding Explanation}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Apply this change" Command="{Binding ApplyCommand}" />
                                <Button Content="Explain further" Command="{Binding ExplainFurtherCommand}"
                                         ToolTip.Tip="Ask Claude Code to go deeper on this step, continuing this tutorial's conversation." />
                                <Button Content="View in Diff" Command="{Binding ViewInDiffCommand}"
                                         ToolTip.Tip="Jump to this step's change on the Diffs page." />
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                            </StackPanel>
                            <controls:MarkdownTextBlock Text="{Binding FurtherExplanation}" FontStyle="Italic" Opacity="0.85"
                                       IsVisible="{Binding FurtherExplanation, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding QuestionText, Mode=TwoWay}"
                                         Watermark="Ask a question about this step..."
                                         Width="320" />
                                <Button Content="Ask" Command="{Binding AskQuestionCommand}"
                                         ToolTip.Tip="Ask Claude Code about this step, continuing this tutorial's conversation." />
                            </StackPanel>
                            <controls:MarkdownTextBlock Text="{Binding QuestionAnswer}" FontStyle="Italic" Opacity="0.85"
                                       IsVisible="{Binding QuestionAnswer, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
