<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             xmlns:controls="using:Paarde.Avalonia.Controls"
             xmlns:helpers="using:Paarde.Avalonia.Helpers"
             x:Class="Paarde.Avalonia.Views.ExplorerFileTabControl"
             x:DataType="vm:OpenFileTabViewModel">

    <!-- Epic 23, T23.1.1: one instance of this control per open Explorer tab (ExplorerView.axaml's
         TabControl.ContentTemplate), same "separate control instance per tab" shape
         TutorialDetailControl already established for TutorialView's tab strip - each instance
         gets its own CodeEditor, rather than one shared editor whose binding path gets swapped. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- UX pass: a real title for this tab's editor, matching TutorialDetailControl's own
             per-file header (icon + full path) instead of leaving the path as tab-strip-only
             tooltip text. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding FilePath}"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </StackPanel>

        <!-- UX pass: Save/Revert lead with icons (same SaveFilled/Restore convention as
             PromptView/TutorialDetailControl) since they're the primary file-editing actions;
             Explain moves to the end as a plain, de-emphasized button. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" VerticalAlignment="Center">
            <!-- T10.2.2/T10.2.6: Save/Revert both gate on IsDirty, so there's nothing to
                 accidentally click before an edit actually diverges from disk. -->
            <Button Command="{Binding SaveCommand}"
                     Classes="accent"
                     ToolTip.Tip="Write this file's edits to disk.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="SaveFilled" FontSize="14" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <Button Command="{Binding RevertToDiskCommand}"
                     ToolTip.Tip="Discard every edit and reload this file's current content from disk.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Restore" FontSize="14" />
                    <TextBlock Text="Revert to disk" />
                </StackPanel>
            </Button>
            <TextBlock Text="Edited" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.7" />
            <Button Content="Explain this file"
                     Command="{Binding ExplainCommand}"
                     ToolTip.Tip="Ask the AI for a tutorial-style explanation of this file." />
            <ui:ProgressRing Width="18" Height="18" VerticalAlignment="Center" IsIndeterminate="True" IsActive="{Binding IsLoadingOverview}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,4"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        <!-- specs/unified-workbench T13 (R5): this tab is carrying a proposed change from a
             prompt run - show which file it's for and a shortcut into the Assistant panel's
             Review tab, since the editor below is now editing that proposal (EffectiveContent)
             rather than the file's plain Content. -->
        <Border Grid.Row="3"
                Margin="0,0,0,4"
                Padding="8,4"
                CornerRadius="4"
                Background="{DynamicResource SystemAccentColor}"
                Opacity="0.15"
                IsVisible="{Binding PendingChange, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:SymbolIcon Symbol="Edit" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding PendingChange.FilePath, StringFormat='Proposed change for {0}'}" />
                <Button Name="OpenInReviewButton"
                        Content="Open in Review"
                        Click="OnOpenInReviewButtonClick"
                        ToolTip.Tip="Switch the Assistant panel to Review for this file." />
            </StackPanel>
        </Border>

        <!-- T10.2.1: editable - BindableText is TwoWay by default (T2.2.2), so edits flow straight
             back into Content, where OnContentChanged derives IsDirty. -->
        <!-- Epic 17, T17.1.2/T17.1.3: Diagnostics feeds the underline renderer/hover tooltip;
             GoToDefinitionRequested/FindReferencesRequested (F12/Shift+F12) and the references
             flyout below are wired up in ExplorerFileTabControl.axaml.cs. -->
        <!-- Epic 25, T13 (R5): EffectiveContent routes through PendingChange.EditedContent when
             there is one (same editing buffer Review's own ReviewFileDetailControl uses), so an
             edit made here and one made there stay in sync; DiffLines/DiffHunks are null on a
             plain tab, where CodeEditor already treats that as "no diff gutter to draw". -->
        <controls:CodeEditor Name="Editor"
                              Grid.Row="4"
                              helpers:TextEditorExtensions.BindableText="{Binding EffectiveContent, Mode=TwoWay}"
                              FilePath="{Binding FilePath}"
                              GhostTextSuggestion="{Binding GhostTextSuggestion}"
                              CompletionItems="{Binding CompletionItems}"
                              Diagnostics="{Binding Diagnostics}"
                              DiffLines="{Binding PendingChange.DiffLines}"
                              DiffHunks="{Binding PendingChange.DiffHunks}"
                              IsReadOnly="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
            <FlyoutBase.AttachedFlyout>
                <Flyout Placement="Bottom">
                    <ListBox Name="ReferencesListBox" MaxHeight="240" MinWidth="320" SelectionChanged="OnReferenceSelected" />
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </controls:CodeEditor>

        <!-- T10.1.4: collapsed until there's something to show, so the editor keeps its full
             height while browsing and only gives up space once an explanation has actually been
             requested. -->
        <Expander Grid.Row="5"
                   Margin="0,8,0,0"
                   Header="Overview"
                   IsExpanded="True"
                   MaxHeight="260"
                   IsVisible="{Binding FileOverview, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <controls:MarkdownTextBlock Margin="4" Text="{Binding FileOverview}" />
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
