<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             xmlns:controls="using:Paarde.Avalonia.Controls"
             x:Class="Paarde.Avalonia.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="Terminal"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0"
                      Text="{Binding CommandText}"
                      Watermark="Type a command to run in the current working directory..."
                      FontFamily="Cascadia Mono,Consolas,monospace" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Run" Command="{Binding RunCommandCommand}" Classes="accent" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelCommandCommand}" IsVisible="{Binding IsRunning}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Clear" Command="{Binding ClearOutputCommand}" />
        </Grid>

        <!-- specs/terminal-emulation T7: the plain-text TextBox is replaced by TerminalControl,
             bound to the TerminalBuffer TerminalViewModel feeds from IPtyProcessManager, same
             swap ShellView.axaml's output strip already got in T6. InputReceived/Resized are
             wired in code-behind (TerminalView.axaml.cs), same reasoning. -->
        <controls:TerminalControl Name="OutputTerminal"
                                  Grid.Row="2"
                                  Margin="0,8,0,0"
                                  FontSize="14"
                                  Buffer="{Binding OutputBuffer}" />

        <TextBlock Grid.Row="3" Margin="0,4,0,0" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
