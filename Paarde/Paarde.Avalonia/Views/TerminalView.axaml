<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:vm="using:Paarde.Presentation.ViewModels"
             xmlns:controls="using:Paarde.Avalonia.Controls"
             x:Class="Paarde.Avalonia.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="Terminal"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0"
                      Text="{Binding CommandText}"
                      KeyDown="OnCommandTextBoxKeyDown"
                      Watermark="Type a command to run in the current working directory..."
                      FontFamily="Cascadia Mono,Consolas,monospace" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RunCommandCommand}" Classes="accent">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Play" FontSize="14" />
                    <TextBlock Text="Run" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding CancelCommandCommand}" IsVisible="{Binding IsRunning}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Stop" FontSize="14" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Margin="8,0,0,0" Command="{Binding ClearOutputCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="Clear" FontSize="14" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- specs/terminal-emulation T7: the plain-text TextBox is replaced by TerminalControl,
             bound to the TerminalBuffer TerminalViewModel feeds from IPtyProcessManager, same
             swap ShellView.axaml's output strip already got in T6. InputReceived/Resized are
             wired in code-behind (TerminalView.axaml.cs), same reasoning. -->
        <controls:TerminalControl Name="OutputTerminal"
                                  Grid.Row="2"
                                  Margin="0,8,0,0"
                                  FontSize="14"
                                  Buffer="{Binding OutputBuffer}" />

        <ui:InfoBar Grid.Row="3"
                    Margin="0,4,0,0"
                    Message="{Binding StatusMessage}"
                    Severity="{Binding StatusSeverity, Converter={StaticResource NotificationSeverityToInfoBarSeverityConverter}}"
                    IsClosable="False"
                    IsOpen="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
</UserControl>
