<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paarde.Avalonia</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia.Generators defaults this to true and auto-attaches DevTools to F12, which swallows
         the key before it ever reaches CodeEditor's own F12 (go-to-definition, specs/editor-
         autocomplete's sibling Epic 17 feature) - App.axaml.cs attaches DevTools itself instead,
         on a gesture that doesn't collide. -->
    <AvaloniaNameGeneratorAttachDevTools>false</AvaloniaNameGeneratorAttachDevTools>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the 11.3.x line rather than the 12.x major to avoid an untested breaking upgrade;
         11.3.22 resolves the Tmds.DBus.Protocol high-severity advisory (NU1903) that 11.2.1 pulled in. -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <!-- AvaloniaEdit depends on Avalonia >= 11.0.0, so this stays compatible with the pinned 11.3.22
         line above; AvaloniaEdit.TextMate + TextMateSharp.Grammars add TextMate-based syntax
         highlighting on top of the base editor control. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- T6.3.2: DPAPI (Windows-only secret protection, used by SecureStorageService) - official,
         minimal Microsoft package; non-Windows platforms use built-in System.Security.Cryptography
         instead, so this is never loaded there. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- T9.2.1: structured, rolling file logging. UseSerilog() (Serilog.Extensions.Hosting) replaces
         the host's default ILoggerFactory wiring, bridging Microsoft.Extensions.Logging.ILogger<T> -
         already injected throughout Core/Avalonia services - onto Serilog's Console/Debug/File sinks. -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paarde.Core\Paarde.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paarde.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
