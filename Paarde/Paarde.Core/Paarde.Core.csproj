<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paarde.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <!-- Abstractions only - no DI container/hosting pulled into Core. Lets services accept an
         optional ILogger<T> (T9.2.1) without this project knowing how logging is wired up; the
         Avalonia host supplies the real implementation via Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Paarde.Core.Tests" />
  </ItemGroup>
</Project>
