<?xml version="1.0" encoding="utf-8"?>
<!-- Flow/Wizard mode's Compose page. Avalonia's PromptView repeats ComposePanelControl's whole body;
     here the page just hosts the control with its own PromptViewModel. -->
<Page
    x:Class="Paarde.WinUI.Views.PromptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Paarde.WinUI.Views">
    <views:ComposePanelControl DataContext="{x:Bind ViewModel}" />
</Page>
