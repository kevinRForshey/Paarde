<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Paarde.WinUI.Views.ReviewFileDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Paarde.WinUI.Controls"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:vm="using:Paarde.Presentation.ViewModels">

    <!-- Port of Paarde.Avalonia's ReviewFileDetailControl (Epic 25, T10): one file's tutorial steps.
         DataContext is the ProposedFileChangeViewModel supplied by ReviewPanelControl's
         ContentControl template; code-behind mirrors it into ViewModel for x:Bind. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <Button AutomationProperties.Name="Revert to proposed" Command="{x:Bind ViewModel.RevertToProposedCommand, Mode=OneWay}"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTipService.ToolTip="Discard your edits and go back to what Claude proposed.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE777;" FontSize="16" />
                    <TextBlock Text="Revert to proposed" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Revert to original" Command="{x:Bind ViewModel.RevertToOriginalCommand, Mode=OneWay}"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTipService.ToolTip="Discard your edits and the proposed change, going back to the file on disk.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE777;" FontSize="16" />
                    <TextBlock Text="Revert to original" />
                </StackPanel>
            </Button>
            <TextBlock Text="Edited" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.7"
                       Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.IsDirty), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8"
                    Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.HasSelectableHunks), Mode=OneWay}">
            <Button AutomationProperties.Name="Select all" Command="{x:Bind ViewModel.SelectAllHunksCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="SelectAll" />
                    <TextBlock Text="Select all" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Select none" Command="{x:Bind ViewModel.SelectNoHunksCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="ClearSelection" />
                    <TextBlock Text="Select none" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Invert selection" Command="{x:Bind ViewModel.InvertHunkSelectionCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Switch" />
                    <TextBlock Text="Invert selection" />
                </StackPanel>
            </Button>
            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <!-- T8.4.3: jump between steps instead of only scrolling, with a position indicator.
             Hidden entirely for a file with no resolved steps. -->
        <StackPanel x:Name="StepNavigationPanel" Grid.Row="2" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <Button AutomationProperties.Name="Previous" x:Name="PreviousStepButton" Click="OnPreviousStepButtonClick"
                    ToolTipService.ToolTip="Jump to the previous step.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                    <TextBlock Text="Previous" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Next" x:Name="NextStepButton" Click="OnNextStepButtonClick"
                    ToolTipService.ToolTip="Jump to the next step.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Next" />
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StepNavigationLabel" VerticalAlignment="Center" />
            <ProgressBar x:Name="StepProgressBar" Width="120" VerticalAlignment="Center" Minimum="0" />
        </StackPanel>

        <ListView x:Name="StepsList" Grid.Row="3" SelectionMode="None" ItemContainerStyle="{StaticResource PlainListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TutorialStepViewModel">
                    <StackPanel Margin="0,0,0,24" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{x:Bind Hunk.IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0"
                                      ToolTipService.ToolTip="Include this step's change when applying." />
                            <TextBlock Text="{x:Bind StepLabel}" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Text="Applied" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.7"
                                       Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(Hunk.IsApplied), Mode=OneWay}" />
                        </StackPanel>
                        <controls:MarkdownTextBlock Text="{x:Bind Explanation}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply this change" Command="{x:Bind ApplyCommand}" />
                            <Button Content="Explain further" Command="{x:Bind ExplainFurtherCommand}"
                                    ToolTipService.ToolTip="Ask Claude Code to go deeper on this step, continuing this tutorial's conversation." />
                            <Button Content="View in Diff" Command="{x:Bind ViewInDiffCommand}"
                                    ToolTipService.ToolTip="Jump to this step's change on the Diffs page." />
                            <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:MarkdownTextBlock Text="{x:Bind FurtherExplanation, Mode=OneWay}" FontStyle="Italic" Opacity="0.85"
                                                    Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(FurtherExplanation), Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind QuestionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Ask a question about this step..."
                                     Width="320" />
                            <Button Content="Ask" Command="{x:Bind AskQuestionCommand}"
                                    ToolTipService.ToolTip="Ask Claude Code about this step, continuing this tutorial's conversation." />
                        </StackPanel>
                        <controls:MarkdownTextBlock Text="{x:Bind QuestionAnswer, Mode=OneWay}" FontStyle="Italic" Opacity="0.85"
                                                    Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(QuestionAnswer), Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
