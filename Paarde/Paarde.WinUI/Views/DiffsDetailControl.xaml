<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Paarde.WinUI.Views.DiffsDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Paarde.WinUI.Controls"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:views="using:Paarde.WinUI.Views">

    <!-- Port of Paarde.Avalonia's DiffsDetailControl. DataContext is a ProposedFileChangeViewModel
         supplied by the host's ContentControl template; code-behind mirrors it into ViewModel for
         x:Bind. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button Content="Copy file contents" Click="OnCopyButtonClick" />
            <!-- T8.3.1: local view-only state toggling between the flat inline diff and a
                 side-by-side one. -->
            <ToggleButton x:Name="SideBySideToggle" Content="Side-by-side" Click="OnViewModeToggled" />
            <!-- T8.3.4: next/previous-change navigation - always jumps the inline view, since
                 there's no side-by-side-row equivalent of a hunk's SourceRangeStart. -->
            <Button x:Name="PreviousChangeButton" Content="Previous change" Click="OnPreviousChangeClick" />
            <Button x:Name="NextChangeButton" Content="Next change" Click="OnNextChangeClick" />
            <TextBlock x:Name="ChangeNavigationStatusText" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <!-- T8.3.2: ItemsSource is set from code-behind (RefreshDisplayRows) - CollapsibleDiffRow
             folds long runs of unchanged lines into one clickable placeholder row. -->
        <!-- Horizontal-only outer scroller, like Avalonia's ScrollViewer around its ItemsControl:
             it measures rows at unlimited width so long lines scroll instead of clipping, while the
             inner ListView still virtualizes vertically. -->
        <ScrollViewer x:Name="InlineScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <ListView x:Name="DiffLinesList"
                      SelectionMode="None"
                      ItemContainerStyle="{StaticResource PlainListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:DiffRowItem">
                        <Grid>
                            <Grid Margin="4,0"
                                  Visibility="{x:Bind helpers:BindingFunctions.CollapsedIf(Row.IsCollapsedPlaceholder)}"
                                  Background="{x:Bind helpers:BindingFunctions.DiffLineBackground(Row.Line.Kind)}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontFamily="{StaticResource MonospaceFontFamily}" Text="{x:Bind Row.Line.Prefix}" />
                                <controls:DiffWordSpanTextBlock Grid.Column="1"
                                                                Margin="4,0,0,0"
                                                                FontFamily="{StaticResource MonospaceFontFamily}"
                                                                LineText="{x:Bind Row.Line.Text}"
                                                                WordSpans="{x:Bind Row.WordSpans}"
                                                                FilePath="{x:Bind FilePath}" />
                            </Grid>
                            <Button Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(Row.IsCollapsedPlaceholder)}"
                                    Content="{x:Bind Row.CollapsedSummary}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnExpandCollapsedRegionClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- T8.3.1/T8.3.2: side-by-side rows, computed on demand rather than kept on the shared
             ProposedFileChangeViewModel since the view mode is local to this control. -->
        <ScrollViewer x:Name="SideBySideScrollViewer"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <ListView x:Name="SideBySideList"
                      SelectionMode="None"
                      ItemContainerStyle="{StaticResource PlainListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:SideBySideRowItem">
                        <Grid>
                            <Grid Visibility="{x:Bind helpers:BindingFunctions.CollapsedIf(Row.IsCollapsedPlaceholder)}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="4,0" Background="{x:Bind helpers:BindingFunctions.DiffCellBackground(Row.Row.OriginalKind)}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource MonospaceFontFamily}" Text="{x:Bind Row.Row.OriginalPrefix}" />
                                    <controls:DiffWordSpanTextBlock Grid.Column="1"
                                                                    Margin="4,0,0,0"
                                                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                                                    LineText="{x:Bind Row.Row.OriginalText}"
                                                                    WordSpans="{x:Bind Row.Row.OriginalWordSpans}"
                                                                    FilePath="{x:Bind FilePath}" />
                                </Grid>
                                <Border Grid.Column="1" Width="1" Margin="8,0" Background="Gray" Opacity="0.3" />
                                <Grid Grid.Column="2" Margin="4,0" Background="{x:Bind helpers:BindingFunctions.DiffCellBackground(Row.Row.ProposedKind)}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource MonospaceFontFamily}" Text="{x:Bind Row.Row.ProposedPrefix}" />
                                    <controls:DiffWordSpanTextBlock Grid.Column="1"
                                                                    Margin="4,0,0,0"
                                                                    FontFamily="{StaticResource MonospaceFontFamily}"
                                                                    LineText="{x:Bind Row.Row.ProposedText}"
                                                                    WordSpans="{x:Bind Row.Row.ProposedWordSpans}"
                                                                    FilePath="{x:Bind FilePath}" />
                                </Grid>
                            </Grid>
                            <Button Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(Row.IsCollapsedPlaceholder)}"
                                    Content="{x:Bind Row.CollapsedSummary}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnExpandCollapsedRegionClick" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</UserControl>
