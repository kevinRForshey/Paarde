<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Paarde.WinUI.Views.ReviewPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Paarde.WinUI.Controls"
    xmlns:coreVm="using:Paarde.Core.ViewModels"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:views="using:Paarde.WinUI.Views">

    <!-- Port of Paarde.Avalonia's ReviewPanelControl (Epic 25, T11): the Review tab's content -
         Apply/Export/Refine sidebar, file list, apply history and overview. DataContext is a
         TutorialViewModel supplied by the host (ReviewView now, the Assistant panel in F31.7);
         code-behind mirrors it into ViewModel for x:Bind. -->
    <Grid x:Name="WorkspaceGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="8" Spacing="4">

                <TextBlock Text="APPLY" Style="{StaticResource SidebarSectionLabelStyle}" />
                <CheckBox Content="Stage applied files in git"
                          IsChecked="{x:Bind ViewModel.StageAppliedFilesInGit, Mode=TwoWay}"
                          ToolTipService.ToolTip="Run `git add` on the files Apply Selected just wrote, so they already show as staged in your next git status." />
                <Button Command="{x:Bind ViewModel.ApplySelectedCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Write every selected change, across every file, to disk.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Accept" />
                        <TextBlock Text="Apply Selected" />
                    </StackPanel>
                </Button>
                <!-- Icons on the danger buttons are deliberate, not decorative: they give the
                     destructive-action signal a second channel beyond color (WCAG 1.4.1). -->
                <Button Command="{x:Bind ViewModel.UndoLastApplyCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTipService.ToolTip="Restore the files from the most recent apply to their content from right before it.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Undo" />
                        <TextBlock Text="Undo Last Apply" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RevertAllAppliedCommand, Mode=OneWay}" HorizontalAlignment="Stretch"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTipService.ToolTip="Restore every file this session has applied a change to back to its content from before this session.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="16" />
                        <TextBlock Text="Revert All Applied" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.ApplyStatusMessage, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                           Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(ViewModel.ApplyStatusMessage), Mode=OneWay}" />

                <!-- T12.2.2: only appears after a configured build/test command fails on apply. -->
                <Button Command="{x:Bind ViewModel.SendBuildTestErrorsToClaudeCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.HasPendingBuildTestFailure), Mode=OneWay}"
                        ToolTipService.ToolTip="Send the captured build/test failure back to Claude Code, continuing this tutorial's conversation, and ask it to fix the problem.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Send" />
                        <TextBlock Text="Send errors to Claude" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.SendBuildTestErrorsStatusMessage, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                           Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(ViewModel.SendBuildTestErrorsStatusMessage), Mode=OneWay}" />

                <Border Margin="0,8,0,0" Style="{StaticResource DividerStyle}" />

                <!-- T8.4.4: saves the overview + every file's numbered steps as a standalone document. -->
                <TextBlock Margin="0,8,0,0" Text="EXPORT" Style="{StaticResource SidebarSectionLabelStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.ExportTutorialAsMarkdownCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Save the tutorial's overview and steps as a Markdown file.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="SaveLocal" />
                            <TextBlock Text="Export as Markdown" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ExportTutorialAsHtmlCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Save the tutorial's overview and steps as an HTML file.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="SaveLocal" />
                            <TextBlock Text="Export as HTML" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ExportStatusMessage, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                           Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(ViewModel.ExportStatusMessage), Mode=OneWay}" />

                <Border Margin="0,8,0,0" Style="{StaticResource DividerStyle}" />

                <!-- T7.3.2: scoped follow-up that only asks Claude to change the selected file. -->
                <TextBlock Margin="0,8,0,0" Text="REFINE" Style="{StaticResource SidebarSectionLabelStyle}" />
                <TextBox Text="{x:Bind ViewModel.RefineInstruction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Refine selected file..."
                         ToolTipService.ToolTip="Describe a change to make to only the selected file, continuing this tutorial's conversation." />
                <Button Command="{x:Bind ViewModel.RefineSelectedFileCommand, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Repair" />
                        <TextBlock Text="Refine selected file" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.RefineStatusMessage, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                           Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(ViewModel.RefineStatusMessage), Mode=OneWay}" />
            </StackPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedFileListItem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsThreeState="True" VerticalAlignment="Center" MinWidth="0"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Select which of this file's changes to apply." />
                            <SymbolIcon Grid.Column="1" Symbol="Document" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FilePath}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind SelectionSummary, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- T4.2.3: apply-history log, collapsed entirely until the first apply/undo/revert of the session. -->
            <StackPanel Grid.Row="2" Margin="8" Spacing="4"
                        Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.HasApplyHistory), Mode=OneWay}">
                <TextBlock Text="Apply History" FontWeight="Bold" FontSize="12" />
                <ListView ItemsSource="{x:Bind ViewModel.ApplyHistoryEntries, Mode=OneWay}" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="11" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>

        <toolkit:GridSplitter Grid.Column="1" x:Name="FileListSplitter" Width="4" ResizeDirection="Columns" />

        <Border Grid.Column="2" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- T8.4.1: the overview from the model's `## Tutorial` section. -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4"
                            Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.HasTutorialOverview), Mode=OneWay}">
                    <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="13" />
                    <controls:MarkdownTextBlock Text="{x:Bind ViewModel.Tutorial, Mode=OneWay}" />
                    <Border Margin="0,8,0,0" Style="{StaticResource DividerStyle}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock Text="No tutorial yet. Run a prompt first, then come back here to review it."
                               Style="{StaticResource EmptyStateTextStyle}"
                               Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.HasNoFiles), Mode=OneWay}" />
                    <TextBlock Text="Select a file from the list to view its tutorial."
                               Style="{StaticResource EmptyStateTextStyle}"
                               Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.HasFilesButNoneSelected), Mode=OneWay}" />

                    <ContentControl Content="{x:Bind ViewModel.Selected, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotNull(ViewModel.Selected), Mode=OneWay}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                                <views:ReviewFileDetailControl />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
