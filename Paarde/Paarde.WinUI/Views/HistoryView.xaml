<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Paarde.WinUI.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreVm="using:Paarde.Core.ViewModels"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:views="using:Paarde.WinUI.Views"
    xmlns:vm="using:Paarde.Presentation.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8" HorizontalAlignment="Right">
            <Button Command="{x:Bind ViewModel.ForkCommand}"
                    ToolTipService.ToolTip="Load this run's prompt and working directory onto the Prompt page to edit before sending.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock Text="Fork" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.RerunCommand}"
                    ToolTipService.ToolTip="Load this run's prompt and working directory onto the Prompt page and send it immediately.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Redo" />
                    <TextBlock Text="Re-run" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- T8.2.3: resizable/persisted pane widths - see ResizablePaneHelper. Dragging either
             splitter all the way shut collapses that pane. -->
        <Grid Grid.Row="1" x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{x:Bind ViewModel.Sessions}"
                      SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistorySessionRow">
                        <TextBlock Text="{x:Bind DisplayText}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <toolkit:GridSplitter Grid.Column="1" x:Name="SessionListSplitter" Width="4" ResizeDirection="Columns" />

            <Border Grid.Column="2" Padding="8">
                <Grid>
                    <TextBlock Text="No past runs yet. Run a prompt first, then come back here to review or re-run it."
                               Style="{StaticResource EmptyStateTextStyle}"
                               Visibility="{x:Bind ViewModel.HasNoSessions, Mode=OneWay}" />
                    <TextBlock Text="This run didn't produce any files."
                               Style="{StaticResource EmptyStateTextStyle}"
                               Visibility="{x:Bind ViewModel.SelectedHasNoFiles, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.SelectedFiles}"
                              SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                                <TextBlock Text="{x:Bind FilePath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <toolkit:GridSplitter Grid.Column="3" x:Name="HistoryFileListSplitter" Width="4" ResizeDirection="Columns" />

            <Border Grid.Column="4" Padding="16">
                <Grid>
                    <TextBlock Text="Select a file from the list to view it as it was in this run."
                               Style="{StaticResource EmptyStateTextStyle}"
                               Visibility="{x:Bind ViewModel.HasFilesButNoneSelected, Mode=OneWay}" />
                    <ContentControl Content="{x:Bind ViewModel.SelectedFile, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotNull(ViewModel.SelectedFile), Mode=OneWay}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                                <views:DiffsDetailControl />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
