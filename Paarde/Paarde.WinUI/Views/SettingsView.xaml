<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Paarde.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:vm="using:Paarde.Presentation.ViewModels"
    xmlns:models="using:Paarde.Core.Models">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8">
            <TextBlock Text="Personalization" Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Theme" />
                <!-- Checked handlers rather than a two-way enum converter: x:Bind's generated
                     BindBack casts whatever ConvertBack returns, so it can't "do nothing" when a
                     button is unchecked. Tag is the AppTheme member name. -->
                <StackPanel Margin="0,4,0,0" Spacing="4">
                    <RadioButton Content="Light" GroupName="AppTheme" Tag="Light" Checked="OnThemeChecked"
                                 IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.Theme, 'Light'), Mode=OneWay}" />
                    <RadioButton Content="Dark" GroupName="AppTheme" Tag="Dark" Checked="OnThemeChecked"
                                 IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.Theme, 'Dark'), Mode=OneWay}" />
                    <RadioButton Content="Default" GroupName="AppTheme" Tag="Default" Checked="OnThemeChecked"
                                 IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.Theme, 'Default'), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <CheckBox Content="Transparent window backdrop (Mica/Acrylic)"
                          IsChecked="{x:Bind ViewModel.IsTransparencyEnabled, Mode=TwoWay}"
                          ToolTipService.ToolTip="Lets the desktop's window-manager backdrop material show through the window chrome. Off by default - falls back to a solid background where it isn't supported." />
            </StackPanel>

            <TextBlock Text="Headroom" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <CheckBox Content="Automatically check Headroom on startup"
                          IsChecked="{x:Bind ViewModel.IsHeadroomIntegrationEnabled, Mode=TwoWay}"
                          ToolTipService.ToolTip="Off by default. When enabled, checks on startup whether the Headroom CLI is installed, healthy, and this project is wired for it, offering to fix anything missing." />
                <Button Content="Check Headroom status now" Command="{x:Bind ViewModel.CheckHeadroomNowCommand}" />
                <InfoBar Margin="0,4,0,0"
                         Message="{x:Bind ViewModel.HeadroomStatusMessage, Mode=OneWay}"
                         Severity="{x:Bind helpers:BindingFunctions.ToInfoBarSeverity(ViewModel.HeadroomStatusSeverity), Mode=OneWay}"
                         IsClosable="False"
                         IsOpen="{x:Bind helpers:BindingFunctions.IsNotEmpty(ViewModel.HeadroomStatusMessage), Mode=OneWay}" />
            </StackPanel>

            <TextBlock Text="Interface" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <RadioButton Content="Editor-focused" GroupName="InterfaceMode" Tag="EditorFocused" Checked="OnInterfaceModeChecked"
                             IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.InterfaceMode, 'EditorFocused'), Mode=OneWay}" />
                <RadioButton Content="Flow/Wizard" GroupName="InterfaceMode" Tag="FlowWizard" Checked="OnInterfaceModeChecked"
                             IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.InterfaceMode, 'FlowWizard'), Mode=OneWay}" />
                <TextBlock Text="Restart Paarde to apply this change."
                           Style="{StaticResource HintStyle}"
                           Visibility="{x:Bind ViewModel.InterfaceModeChangeRequiresRestart, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Text="LLM runner" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <RadioButton Content="Claude Code CLI" GroupName="LlmRunner" Tag="ClaudeCli" Checked="OnRunnerKindChecked"
                             IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.SelectedRunnerKind, 'ClaudeCli'), Mode=OneWay}" />
                <RadioButton Content="Anthropic API (direct)" GroupName="LlmRunner" Tag="AnthropicApi" Checked="OnRunnerKindChecked"
                             IsChecked="{x:Bind helpers:BindingFunctions.IsEnumValue(ViewModel.SelectedRunnerKind, 'AnthropicApi'), Mode=OneWay}" />
            </StackPanel>

            <TextBlock Text="Claude Code CLI" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Executable path" Style="{StaticResource HintStyle}" />
                <TextBox Text="{x:Bind ViewModel.ClaudeCliExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="claude" />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Arguments" Style="{StaticResource HintStyle}" />
                <TextBox Text="{x:Bind ViewModel.ClaudeCliArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="-p" />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <CheckBox Content="Enable read-only agent tools"
                          IsChecked="{x:Bind ViewModel.AgentToolsEnabled, Mode=TwoWay}"
                          ToolTipService.ToolTip="Lets the model read files, grep, and glob the project itself while generating a response, instead of only seeing the context Paarde inlined. Doesn't let it write or run commands. Requires a Claude Code CLI build that supports --allowedTools/--permission-mode (run `claude --version`; upgrade with `npm install -g @anthropic-ai/claude-code` if enabling this fails)." />
                <TextBlock Text="Applies to whichever runner above is selected." Style="{StaticResource HintStyle}" />
            </StackPanel>

            <TextBlock Text="Anthropic API" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="API key" Style="{StaticResource HintStyle}" />
                <PasswordBox Password="{x:Bind ViewModel.AnthropicApiKey, Mode=TwoWay}" PlaceholderText="sk-ant-..." />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Model" Style="{StaticResource HintStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels}"
                          SelectedItem="{x:Bind ViewModel.SelectedAnthropicModel, Mode=TwoWay}"
                          MinWidth="220">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AnthropicModelInfo">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Build &amp; test" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Build command" Style="{StaticResource HintStyle}" />
                <TextBlock Text="Run after applying changes to check the result still builds. Leave blank to skip." Style="{StaticResource HintStyle}" />
                <TextBox Text="{x:Bind ViewModel.BuildCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="dotnet build" />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Test command" Style="{StaticResource HintStyle}" />
                <TextBlock Text="Run after a successful build. Leave blank to skip." Style="{StaticResource HintStyle}" />
                <TextBox Text="{x:Bind ViewModel.TestCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="dotnet test" />
            </StackPanel>

            <TextBlock Text="Code intelligence" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Powers Explorer's diagnostics, go-to-definition, and find-references, one language server per row. Each must speak the Language Server Protocol over stdio. Clear a row's executable path to disable that language."
                       Style="{StaticResource HintStyle}" />

            <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.LanguageServerRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LanguageServerOptionsRowViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind LanguageId}" FontWeight="SemiBold" />
                                    <TextBlock Text="Available"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Visibility="{x:Bind IsAvailable, Mode=OneWay}" />
                                    <TextBlock Text="Not found on PATH"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{x:Bind helpers:BindingFunctions.CollapsedIf(IsAvailable), Mode=OneWay}" />
                                </StackPanel>
                                <TextBox Text="{x:Bind ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="executable path" />
                                <TextBox Text="{x:Bind Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="arguments" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Run configurations" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Powers the Build/Run/Stop toolbar - detected automatically for the working directory picked on the Prompt page, or add one by hand for anything detection misses."
                       Style="{StaticResource HintStyle}" />

            <TextBlock Margin="0,8,0,0"
                       Text="No working directory selected yet. Pick one on the Prompt page."
                       Style="{StaticResource HintStyle}"
                       Visibility="{x:Bind helpers:BindingFunctions.CollapsedIf(ViewModel.HasRunConfigurationsWorkingDirectory), Mode=OneWay}" />

            <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.RunConfigurationRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RunConfigurationRowViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-detected"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Visibility="{x:Bind IsAutoDetected}" />
                                        <TextBlock Text="Hand-edited"
                                                   Style="{StaticResource HintStyle}"
                                                   Visibility="{x:Bind helpers:BindingFunctions.CollapsedIf(IsAutoDetected)}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Delete" Command="{x:Bind DeleteCommand}" />
                                </Grid>
                                <TextBox Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="name" />
                                <TextBox Text="{x:Bind LanguageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="language id (csharp/python/typescript)" />
                                <TextBox Text="{x:Bind WorkingDirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="directory the commands below run in" />
                                <TextBox Text="{x:Bind ProjectRelativePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="project/script path (for your reference)" />
                                <TextBox Text="{x:Bind BuildCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="build command (leave blank to skip)" />
                                <TextBox Text="{x:Bind RunCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="run command" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Margin="0,8,0,0" Content="Add run configuration" Command="{x:Bind ViewModel.AddRunConfigurationCommand}" />

            <TextBlock Text="Prompt template" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Override" Style="{StaticResource HintStyle}" />
                <TextBlock Text="Instructions sent to Claude Code before your prompt. Leave blank to use the built-in default shown below." Style="{StaticResource HintStyle}" />
                <TextBox Text="{x:Bind ViewModel.PromptTemplateOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Leave blank to use the built-in default"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas"
                         Height="160"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button Content="Reset to default" Command="{x:Bind ViewModel.ResetPromptTemplateCommand}" />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Built-in default" Style="{StaticResource HintStyle}" />
                <TextBox Text="{x:Bind ViewModel.DefaultPromptTemplate}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Mono, Consolas"
                         Height="160"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>

            <TextBlock Text="About this application" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Margin="0,4,0,0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
