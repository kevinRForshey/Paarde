<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Paarde.WinUI.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:vm="using:Paarde.Presentation.ViewModels">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="720">

            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- specs/fluent-design-pass R5: 14 kept literal - the app's brand mark, deliberately
                     rounder than the theme's control/overlay radii. -->
                <Border Width="64" Height="64" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="P"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Paarde" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Prompt Assist And Review Development Environment" Style="{StaticResource StatusTextStyle}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,16,0,0" Spacing="8">
                <TextBlock Text="Quick prompt" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{x:Bind ViewModel.QuickPromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Describe what you want built or changed..."
                             Width="560"
                             AcceptsReturn="False" />
                    <Button Content="Send"
                            Command="{x:Bind ViewModel.SendQuickPromptCommand}"
                            ToolTipService.ToolTip="Load this onto the Compose page (with your last-used working directory) to review before sending." />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,16,0,0" Spacing="8" Visibility="{x:Bind ViewModel.HasRecentRuns, Mode=OneWay}">
                <TextBlock Text="Recent runs" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.RecentRuns}"
                          SelectedItem="{x:Bind ViewModel.SelectedRecentRun, Mode=TwoWay}"
                          MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistorySessionRow">
                            <TextBlock Text="{x:Bind DisplayText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Open"
                        Command="{x:Bind ViewModel.OpenRecentRunCommand}"
                        ToolTipService.ToolTip="Load this run's prompt and working directory onto the Compose page to edit before sending." />
            </StackPanel>

            <StackPanel Margin="0,16,0,0" Spacing="8" Visibility="{x:Bind ViewModel.HasRecentProjects, Mode=OneWay}">
                <TextBlock Text="Recent projects" Style="{StaticResource SectionHeaderStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.RecentProjects}"
                          SelectedItem="{x:Bind ViewModel.SelectedRecentProject, Mode=TwoWay}"
                          MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Switch to this project"
                        Command="{x:Bind ViewModel.OpenRecentProjectCommand}"
                        ToolTipService.ToolTip="Switch the Compose page's working directory to this project." />
            </StackPanel>

            <TextBlock Margin="0,16,0,0" Text="Getting started" Style="{StaticResource SectionHeaderStyle}" />

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="1." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="680"
                               Text="Open the Compose tab and click Browse... to choose the project folder you want Claude Code to work in." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="2." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="680"
                               Text="Describe what you want built or changed in the prompt box. Optionally attach context files or folders, pick a preset and tutorial detail level, then click Send to Claude Code." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="3." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="680"
                               Text="Once it finishes, you'll be taken to the Review tab to read the explanation, or see the proposed changes file by file." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="4." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="680"
                               Text="On the Review tab, select the files or individual hunks you want - editing the proposed content first if you'd like - then click Apply Selected to write them to disk. Undo Last Apply and Revert All Applied are there if you change your mind." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="5." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="680"
                               Text="Visit Settings to point the app at your claude CLI executable, customize the prompt template, switch themes, or switch back to the Editor-focused interface." />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
