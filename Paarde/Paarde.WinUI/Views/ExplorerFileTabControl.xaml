<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Paarde.WinUI.Views.ExplorerFileTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:Paarde.WinUI.Controls"
    xmlns:helpers="using:Paarde.WinUI.Helpers"
    xmlns:models="using:Paarde.Core.Models"
    xmlns:views="using:Paarde.WinUI.Views">

    <!-- Port of Paarde.Avalonia's ExplorerFileTabControl. Avalonia has one of these (and one editor)
         per open tab; here there's one per tab group, showing whichever tab that group has selected
         (ViewModel, set by ExplorerView), because each code editor is a ~90 MB WebView2
         (design.md "Code editor"). The editor keeps one Monaco model per file, so switching tabs
         keeps each file's undo history, caret and scroll position. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- T10.2.2/T10.2.6: Save/Revert both gate on IsDirty. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <Button AutomationProperties.Name="Save" Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Write this file's edits to disk.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Save" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.Name="Revert to disk" Command="{x:Bind ViewModel.RevertToDiskCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Discard every edit and reload this file's current content from disk.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE777;" FontSize="16" />
                    <TextBlock Text="Revert to disk" />
                </StackPanel>
            </Button>
            <TextBlock Text="Edited" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.7"
                       Visibility="{x:Bind helpers:BindingFunctions.VisibleIf(ViewModel.IsDirty), Mode=OneWay}" />
            <Button Content="Explain this file"
                    Command="{x:Bind ViewModel.ExplainCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Ask the AI for a tutorial-style explanation of this file." />
            <ProgressRing Width="18" Height="18" VerticalAlignment="Center" IsIndeterminate="True"
                          IsActive="{x:Bind ViewModel.IsLoadingOverview, Mode=OneWay}" />
        </StackPanel>

        <InfoBar Grid.Row="2"
                 Margin="0,0,0,4"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 Severity="{x:Bind helpers:BindingFunctions.ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                 IsClosable="False"
                 IsOpen="{x:Bind helpers:BindingFunctions.IsNotEmpty(ViewModel.StatusMessage), Mode=OneWay}" />

        <!-- specs/unified-workbench T13 (R5): this tab carries a proposed change from a prompt run,
             so the editor is editing that proposal (EffectiveContent) rather than the plain file. -->
        <Border Grid.Row="3"
                Margin="0,0,0,4"
                Padding="8,4"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotNull(ViewModel.PendingChange), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Edit" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           Text="{x:Bind FormatProposedChange(ViewModel.PendingChange.FilePath), Mode=OneWay}" />
                <Button Content="Open in Review"
                        Click="OnOpenInReviewButtonClick"
                        ToolTipService.ToolTip="Switch the Assistant panel to Review for this file." />
            </StackPanel>
        </Border>

        <!-- specs/editor-intelligence R4: collapsible outline panel (drag shut to collapse),
             persisted via OutlinePanelWidth like Avalonia's. -->
        <Grid x:Name="OutlinePanelGrid" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="OutlineTreeView"
                      Grid.Column="0"
                      SelectionMode="None"
                      ItemsSource="{x:Bind ViewModel.DocumentSymbols.Children, Mode=OneWay}"
                      ItemInvoked="OnOutlineItemInvoked">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:LspDocumentSymbol">
                        <TreeViewItem Content="{x:Bind Name}" ItemsSource="{x:Bind Children}" />
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <toolkit:GridSplitter Grid.Column="1" x:Name="OutlineSplitter" Width="4" ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- specs/editor-intelligence R5. -->
                <views:BreadcrumbBar Grid.Row="0"
                                     Margin="0,0,0,4"
                                     DocumentSymbols="{x:Bind ViewModel.DocumentSymbols, Mode=OneWay}"
                                     CaretPosition="{x:Bind Editor.CaretPosition, Mode=OneWay}"
                                     SegmentClicked="OnBreadcrumbSegmentClicked" />

                <controls:CodeEditor x:Name="Editor" Grid.Row="1">
                    <!-- Epic 17, T17.1.3: Shift+F12's results. -->
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Bottom">
                            <ListView x:Name="ReferencesList"
                                      MaxHeight="240"
                                      MinWidth="320"
                                      IsItemClickEnabled="True"
                                      SelectionMode="None"
                                      ItemClick="OnReferenceClicked" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:CodeEditor>
            </Grid>
        </Grid>

        <!-- T10.1.4: hidden until an explanation has been requested. -->
        <Expander Grid.Row="5"
                  Margin="0,8,0,0"
                  Header="Overview"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Visibility="{x:Bind helpers:BindingFunctions.VisibleIfNotEmpty(ViewModel.FileOverview), Mode=OneWay}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <controls:MarkdownTextBlock Margin="4" Text="{x:Bind ViewModel.FileOverview, Mode=OneWay}" />
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
