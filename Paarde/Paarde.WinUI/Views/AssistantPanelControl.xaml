<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Paarde.WinUI.Views.AssistantPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Paarde.WinUI.Views">

    <!-- Epic 25, T8: the docked Assistant panel inside ExplorerView - Compose and Review, the same
         two controls PromptView/ReviewView host as pages. WinUI has no TabControl, so a SelectorBar
         picks the visible one; the selection <-> AssistantPanelViewModel.SelectedTabIndex sync is in
         code-behind (a finished run switches to Review on its own). -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="TabSelectorBar" SelectionChanged="OnTabSelectorBarSelectionChanged">
            <SelectorBarItem Text="Compose" />
            <SelectorBarItem Text="Review" />
        </SelectorBar>
        <views:ComposePanelControl x:Name="ComposePane" Grid.Row="1" DataContext="{x:Bind ViewModel.Compose, Mode=OneWay}" />
        <views:ReviewPanelControl x:Name="ReviewPane" Grid.Row="1" Visibility="Collapsed" DataContext="{x:Bind ViewModel.Review, Mode=OneWay}" />
    </Grid>
</UserControl>
