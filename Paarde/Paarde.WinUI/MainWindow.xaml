<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Paarde.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Solid page background, hidden while a Mica/Acrylic backdrop is in use (see
             ApplyTransparency) so the backdrop shows through. A ThemeResource here, rather than a
             brush set from code, keeps it following theme switches. -->
        <Border x:Name="SolidBackground"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" />

        <ContentPresenter x:Name="ShellHost" Grid.Row="1" />
    </Grid>
</Window>
