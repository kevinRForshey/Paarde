<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Paarde.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Same colors as Paarde.Avalonia's App.axaml (WCAG AA against each theme's button
                 background). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="DangerButtonPointerOverBrush" Color="#A4262C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="DangerButtonPointerOverBrush" Color="#FFB3BC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Paarde.Avalonia's Button.danger class: destructive actions keep the default button
                 chrome and only recolor foreground/border. WinUI's button template reads these
                 resource keys for its pointer-over state, so overriding them per style is enough. -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource DangerButtonBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DangerButtonBrush}" />
            </Style>

            <!-- Section labels in the Review sidebar ("APPLY", "EXPORT", "REFINE"). -->
            <Style x:Key="SidebarSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.6" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Stands in for Avalonia's Separator, which WinUI has no general-purpose equivalent of. -->
            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- List rows with no ListViewItem padding/min-height, for dense line-per-row lists (diff
                 lines) where SelectionMode="None" - ListView rather than ItemsControl only for its
                 virtualization and ScrollIntoView. -->
            <Style x:Key="PlainListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- specs/fluent-design-pass R2: shared chrome for every floating popup (Quick Open,
                 Command Palette, Go to Symbol, the Ctrl+Tab switcher, the @-mention list) -
                 Paarde.Avalonia's Border.popup-chrome. Sizes stay on each popup. -->
            <Style x:Key="PopupChromeBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>

            <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
